# Copy to frontend-web/.env locally or configure these as build environment variables.
# Values come from Firebase Console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional deployed C Trader API base URL. Keep empty for same-origin/proxy setup.
VITE_C_TRADER_API_URL=
